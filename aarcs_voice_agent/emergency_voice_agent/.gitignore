# Save this as .gitignore in your project root
@"
# ============================================
# CRITICAL: Firebase Service Account Keys (NEVER COMMIT)
# ============================================
**/serviceAccountKey.json
**/serviceAccountKey*.json
**/*service-account*.json
**/*credentials*.json
aarcs_voice_agent/emergency_voice_agent/serviceAccountKey.json
aarcs_voice_agent/emergency_voice_agent/scripts/serviceAccountKey.json
**/*.key
**/*.pem
**/*.cert

# ============================================
# Environment Variables (NEVER COMMIT)
# ============================================
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
env.bak/
venv.bak/
aarcs_voice_agent/venv/
aarcs_voice_agent/emergency_voice_agent/venv/

# ============================================
# Node.js
# ============================================
node_modules/
aarcs_backend/node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# ============================================
# Flutter/Dart
# ============================================
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/Dart/
**/dart-sdk/

# ============================================
# IDE/Editor files
# ============================================
.idea/
.vscode/
*.iml
.DS_Store

# ============================================
# OS generated files
# ============================================
Thumbs.db
ehthumbs.db
Desktop.ini
"@ | Out-File -FilePath .gitignore -Encoding utf8