# Create .gitignore file with the following content
@"
# Firebase service account keys (SENSITIVE - DO NOT COMMIT)
aarcs_voice_agent/emergency_voice_agent/serviceAccountKey.json
**/serviceAccountKey.json
**/*.json

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
"@ | Out-File -FilePath .gitignore -Encoding utf8